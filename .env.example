# ============================================================
# Multi-Agent Ticket System - environment configuration
# Copy to .env (or export in shell). All variables use AGENT_ prefix.
# ============================================================

# --- Service ---
AGENT_ENVIRONMENT=development
AGENT_DEBUG=false
AGENT_HOST=0.0.0.0
AGENT_PORT=8000

# --- LLM (agnes-3-flash via Sapiens, OpenAI-compatible) ---
AGENT_LLM_PROVIDER=agnes
AGENT_LLM_MODEL=agnes-3-flash
AGENT_LLM_API_KEY=sk-your-sapiens-key-here
AGENT_LLM_BASE_URL=https://api.sapiens.ai/v1
AGENT_LLM_TIMEOUT_S=30
AGENT_LLM_MAX_RETRIES=3
AGENT_LLM_TEMPERATURE=0.2
# Set to false to force keyword-based routing (offline / no API key)
AGENT_LLM_ENABLED=true

# --- Database ---
AGENT_SQLITE_PATH=data/tickets.sqlite3
AGENT_USE_REDIS=false
AGENT_REDIS_URL=redis://127.0.0.1:6379/0

# --- Security ---
# Use a long random string in production (>= 32 bytes)
AGENT_JWT_SECRET=change-me-in-production-use-a-long-random-string
AGENT_JWT_EXPIRES_MINUTES=720

